# Copy to .env. Keep every key on the server; never commit real API responses.
DATA_MODE=demo
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com
# Global upstream attempts per worker lifetime. Includes retries and search.
QLOO_GLOBAL_REQUEST_LIMIT=500
QLOO_SCENARIO_REQUEST_LIMIT=10
QLOO_TIMEOUT_SECONDS=8
RATE_LIMIT_PER_MINUTE=40
# Set a random value of at least 32 characters for deployments; blank generates one.
APP_SECRET=
# This build uses structured input and evidence templates; no paid LLM is enabled.
LLM_PROVIDER=none
PORT=8000
